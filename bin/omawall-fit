#!/usr/bin/env python3
"""Image dimensions and fit checks for klieber.omawall.

dims:  identify each path, print JSON {path: [width, height]}
Used by Background.qml after a folder scan. Fit itself runs in Fit.js.
"""

from __future__ import annotations

import json
import subprocess
import sys


def image_size(path: str) -> tuple[int, int] | None:
    try:
        out = subprocess.check_output(
            ["identify", "-ping", "-format", "%w %h", path],
            stderr=subprocess.DEVNULL,
            text=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return None
    parts = out.split()
    if len(parts) < 2:
        return None
    try:
        return int(parts[0]), int(parts[1])
    except ValueError:
        return None


def cmd_dims(paths: list[str]) -> dict[str, list[int]]:
    out: dict[str, list[int]] = {}
    for path in paths:
        size = image_size(path)
        if size is None:
            continue
        out[path] = [size[0], size[1]]
    return out


def main(argv: list[str]) -> int:
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print("usage: omawall-fit dims [path ...]", file=sys.stderr)
        return 2
    if argv[1] != "dims":
        print(f"omawall-fit: unknown command {argv[1]!r}", file=sys.stderr)
        return 2
    paths = argv[2:]
    if not paths:
        paths = [line.strip() for line in sys.stdin if line.strip()]
    json.dump(cmd_dims(paths), sys.stdout, separators=(",", ":"))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
